select.bx-select {
    min-height: 30px;
}

div.bx-select {
    display: flex;
    position: relative;
    // Settings rows can be taller because of notes. Do not stretch the
    // selector's white value panel to the height of that explanatory text.
    align-items: center;
    flex: 0 1 auto;
    gap: 8px;

    select {
        &:disabled {
            & ~ button {
                display: none;
            }

            & ~ div {
                background: #131416;
                color: white;
                pointer-events: none;

                .bx-select-indicators {
                    visibility: hidden;
                }
            }
        }
    }

    > div, button.bx-select-value {
        min-width: 120px;
        text-align: left;
        line-height: 24px;
        vertical-align: middle;
        background: #fff;
        color: #000;
        border-radius: 4px;
        padding: 2px 8px;
        display: flex;
        flex: 1;
        flex-direction: column;
    }

    > div {
        min-height: 24px;

        input {
            display: inline-block;
            margin-right: 8px;
        }

        label {
            margin-bottom: 0;
            font-size: 14px;
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            min-height: 15px;

            span {
                display: block;
                font-size: 10px;
                font-weight: bold;
                text-align: left;
                line-height: 20px;
                white-space: pre;
                min-height: 15px;
                align-content: center;
            }
        }
    }

    button.bx-select-value {
        border: none;
        cursor: pointer;
        min-height: 30px;
        font-size: 0.9rem;
        align-items: center;

        > div {
            display: flex;
            width: 100%;
        }

        span {
            flex: 1;
            text-align: left;
            display: inline-block;
        }

        input {
            margin: 0 4px;
            accent-color: var(--bx-primary-button-color);
            pointer-events: none;
        }

        &:hover,
        &:focus {
            input {
                accent-color: var(--bx-danger-button-color);
            }

            &::after {
                border-color: #4d4d4d !important;
            }
        }
    }

    button.bx-button {
        border: none;
        width: 24px;
        height: auto;
        padding: 0;
        color: #fff;
        border-radius: 4px;
        font-weight: bold;
        font-size: 12px;
        font-family: var(--bx-monospaced-font);
        flex-shrink: 0;

        span {
            line-height: unset;
        }
    }

    &[data-controller-friendly=true] {
        > div {
            box-sizing: content-box;
        }

        select {
            // Render offscreen instead of "display: none" so we could get its size
            position: absolute !important;
            top: -9999px !important;
            left: -9999px !important;
            visibility: hidden !important;
        }
    }

    &[data-controller-friendly=false] {
        position: relative;

        > div {
            box-sizing: border-box;

            label {
                margin-right: 24px;
            }
        }

        select {
            &:disabled {
                display: none;
            }

            &:not(:disabled) {
                cursor: pointer;
                position: absolute;
                top: 0;
                right: 0;
                bottom: 0;
                display: block;

                opacity: 0;
                z-index: calc(var(--bx-settings-z-index) + 1);

                &:hover {
                    + div {
                        background: #f0f0f0;
                    }
                }

                + div {
                    label {
                        &::after {
                            content: '▾';
                            font-size: 14px;
                            position: absolute;
                            right: 8px;
                            pointer-events: none;
                        }
                    }
                }
            }
        }
    }
}

// Promptfont does not include color-country glyphs on Windows. Explicitly
// provide the OS emoji fonts so desktop region choices keep their flags just
// like the Android app's native selector.
.bx-settings-dialog .bx-select label {
    font-family: var(--bx-normal-font), "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
}

// The desktop selector is custom-rendered, unlike Android's native select.
// Keep the flag in its own element so Windows always chooses an emoji font.
.bx-select-flag {
    display: inline-block;
    margin: 0 6px 0 2px;
    font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif !important;
    line-height: inherit;
}

.bx-select-flag-image {
    display: inline-block;
    width: 20px;
    height: 15px;
    margin: 0 6px 0 2px;
    object-fit: cover;
    vertical-align: -2px;
    border-radius: 1px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .2);
}

.bx-locale-flag {
    display: inline-block;
    width: 18px;
    height: 13px;
    margin-right: 5px;
    object-fit: cover;
    vertical-align: -1px;
    border-radius: 1px;
}

.bx-server-menu-flag {
    display: inline-block;
    width: 18px;
    height: 13px;
    margin-right: 5px;
    object-fit: cover;
    vertical-align: -2px;
    border-radius: 1px;
}

// The settings always creates controller controls so they work with A/D-pad.
// When a pointer or keyboard is used, reveal the underlying native selector
// again for the familiar mouse/keyboard layout.
html[data-active-input=mouse],
html[data-active-input=keyboard] {
    .bx-navigation-dialog div.bx-select[data-controller-friendly=true] {
        position: relative;

        > button.bx-button {
            display: none;
        }

        > div {
            box-sizing: border-box;

            label {
                margin-right: 24px;

                &::after {
                    content: '▾';
                    font-size: 14px;
                    position: absolute;
                    right: 8px;
                    pointer-events: none;
                }
            }
        }

        select:not(:disabled) {
            cursor: pointer;
            position: absolute !important;
            top: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            left: 0 !important;
            display: block !important;
            visibility: visible !important;
            opacity: 0;
            z-index: 2;

            &:hover + div {
                background: #f0f0f0;
            }
        }
    }
}

.bx-select-indicators {
    display: flex;
    height: 4px;
    gap: 2px;
    margin-bottom: 2px;

    span {
        content: ' ';
        display: inline-block;
        flex: 1;
        background: #cfcfcf;
        border-radius: 4px;
        min-width: 1px;

        &[data-highlighted] {
            background: #9c9c9c;
            min-width: 6px;
        }

        &[data-selected] {
            background: #aacfe7;
        }

        &[data-highlighted][data-selected] {
            background: #5fa3d0;
        }
    }
}

// Dropdown for controller-friendly multi-selects when operated with a
// pointer or keyboard. It is portaled to <body> to avoid clipped menus.
.bx-select-multiple-dropdown {
    position: fixed;
    z-index: 2147483647;
    max-height: 260px;
    overflow-y: auto;
    padding: 0;
    border: 1px solid #3f3f3f;
    background: #393939;
    box-shadow: 0 8px 18px #000c;
}

.bx-select-multiple-dropdown-option {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-height: 27px;
    padding: 3px 8px;
    border: 0;
    background: #393939;
    color: #fff;
    font: inherit;
    text-align: left;
    cursor: pointer;

    input {
        margin: 0;
        accent-color: var(--bx-primary-button-color);
        pointer-events: none;
    }

    &:hover, &:focus {
        background: #4b4b4b;
        color: #fff;
    }

    &[data-selected=true] {
        background: #176fa9;
        color: #fff;
    }
}

// Custom single-select menu used for server regions. Native Windows menus
// only accept text in <option>, so flags must be rendered outside them.
.bx-select-flag-dropdown {
    position: absolute;
    top: calc(100% + 3px);
    left: 0;
    z-index: 2147483647;
    max-height: 360px;
    overflow-y: auto;
    padding: 4px 0;
    border: 1px solid #3f3f3f;
    background: #393939;
    box-shadow: 0 8px 18px #000c;
}

.bx-select-flag-dropdown-group {
    padding: 5px 10px 2px;
    color: #fff;
    font-size: 12px;
    font-weight: bold;
}

.bx-select-flag-dropdown-option {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 30px;
    padding: 4px 10px;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    text-align: left;
    cursor: pointer;

    .bx-select-flag-image {
        flex: 0 0 auto;
    }

    &:hover, &:focus, &[data-selected=true] {
        background: #176fa9;
        color: #fff;
    }
}

// The compact value of a multiple selector opens a dropdown in pointer/
// keyboard mode; give it the same visual cue as native selects.
div.bx-select[data-controller-friendly=true] button.bx-select-value {
    position: relative;
    padding-right: 28px;

    &::before {
        content: '▾';
        position: absolute;
        top: 50%;
        right: 9px;
        transform: translateY(-50%);
        color: #f5f5f5;
        font-size: 12px;
        pointer-events: none;
    }
}

// Multiple selectors have two layouts: the compact, focusable controller
// layout above and a real native list for mouse/keyboard.  Do not leave the
// controller's current-item checkbox visible after the input method changes.
html[data-active-input=mouse],
html[data-active-input=keyboard] {
    .bx-navigation-dialog div.bx-select[data-controller-friendly=true]:has(button.bx-select-value) {
        > button.bx-select-value {
            display: none;
        }

        select:not(:disabled) {
            pointer-events: auto !important;
            position: relative !important;
            top: auto !important;
            right: auto !important;
            bottom: auto !important;
            left: auto !important;
            width: 100%;
            min-height: 28px;
            visibility: visible !important;
            opacity: 1;
            z-index: 2;
            color: #fff;
            background: #171819;
            border: 1px solid #4b4f51;
            border-radius: 2px;
        }
    }
}
